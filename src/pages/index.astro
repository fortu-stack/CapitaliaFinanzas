---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Obtenemos y ordenamos los artículos del blog
const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Capitalia Finanzas - Tu portal de economía y gestión">
    <!-- Hero Principal más visual y dinámico -->
    <section class="bg-gradient-to-r from-slate-900 to-blue-950 text-white py-20 px-4">
        <div class="max-w-4xl mx-auto text-center">
            <span class="bg-blue-600 text-xs font-semibold uppercase tracking-wider px-3.5 py-1.5 rounded-full">Portal Profesional YMYL</span>
            <h1 class="text-4xl md:text-5xl font-extrabold mt-6 mb-4 leading-tight">
                Construye tu libertad financiera con estrategias probadas
            </h1>
            <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto">
                Guías prácticas, análisis del mercado en España y herramientas interactivas diseñadas para blindar tu patrimonio.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="/calculadora" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3.5 rounded-xl transition shadow-lg">
                    Probar Calculadoras Interactivas &rarr;
                </a>
                <a href="#articulos" class="bg-white/10 hover:bg-white/20 text-white font-medium px-6 py-3.5 rounded-xl transition backdrop-blur-sm">
                    Ver Guías Recientes
                </a>
            </div>
        </div>
    </section>

    <!-- Cuadrícula de Artículos Moderna y Visual -->
    <section id="articulos" class="max-w-6xl mx-auto px-4 py-16">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-bold text-gray-900 border-l-4 border-blue-600 pl-3">
                Últimas Guías y Análisis
            </h2>
        </div>
        
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {
                posts.map((post) => (
                    <article class="bg-white border border-slate-200/80 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
                        <div>
                            {post.data.heroImage && (
                                <img src={post.data.heroImage.src} alt={post.data.title} class="w-full h-48 object-cover" />
                            )}
                            <div class="p-6">
                                <h3 class="font-bold text-lg text-gray-900 mb-2 leading-snug hover:text-blue-600 transition">
                                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                                </h3>
                                <p class="text-gray-600 text-sm line-clamp-3 mb-4">{post.data.description}</p>
                            </div>
                        </div>
                        <div class="px-6 pb-6 pt-0">
                            <a href={`/blog/${post.id}/`} class="inline-flex items-center text-blue-600 font-semibold text-sm hover:underline">
                                Leer artículo completo &rarr;
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
</Layout>