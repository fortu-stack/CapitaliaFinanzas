---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Ordenar artículos por fecha (más recientes primero)
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

// Función segura para obtener la URL limpia del artículo
function getPostSlug(post: any): string {
  if (post.slug) return post.slug;
  if (post.id) return post.id.replace(/\.(md|mdx)$/, '');
  return '';
}

// Artículo principal (el más reciente para la cabecera destacada)
const featuredPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 7); // Siguientes artículos para la rejilla
---

<Layout title="Capitalia Finanzas | Análisis Económico, Vivienda e Inversión" description="Análisis independiente sobre economía, fiscalidad, vivienda y finanzas personales en España.">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Barra de Últimas Novedades -->
    {featuredPost && (
      <div class="bg-blue-950 text-white rounded-2xl p-4 sm:p-6 mb-12 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="bg-amber-400 text-blue-950 text-xs font-black uppercase px-2.5 py-1 rounded-md tracking-wider">
            Última Novedad
          </span>
          <a href={`/blog/${getPostSlug(featuredPost)}`} class="text-sm sm:text-base font-semibold hover:text-amber-400 transition-colors line-clamp-1">
            {featuredPost.data.title}
          </a>
        </div>
        <a href={`/blog/${getPostSlug(featuredPost)}`} class="text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors whitespace-nowrap">
          Leer análisis completo →
        </a>
      </div>
    )}

    <!-- Sección Principal / Hero si existe, o rejilla de artículos destacados -->
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Análisis y Actualidad Financiera
      </h1>
      <p class="mt-2 text-lg text-slate-600">
        Descubre nuestros últimos estudios sobre economía, vivienda, impuestos y patrimonio.
      </p>
    </div>

    <!-- Rejilla de Artículos de la Portada -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {recentPosts.map((post) => {
        const postUrl = getPostSlug(post);
        return (
          <article class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden hover:shadow-md transition-all flex flex-col justify-between">
            <div class="p-6">
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md">
                  {post.data.category || 'Análisis'}
                </span>
                <time class="text-slate-400 font-medium">
                  {new Date(post.data.pubDate).toLocaleDateString('es-ES', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  })}
                </time>
              </div>

              <h2 class="text-xl font-bold text-slate-900 hover:text-blue-950 transition-colors line-clamp-2">
                <a href={`/blog/${postUrl}`}>
                  {post.data.title}
                </a>
              </h2>

              <p class="mt-3 text-slate-600 text-sm leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <div class="px-6 pb-6 pt-2">
              <a
                href={`/blog/${postUrl}`}
                class="inline-flex items-center text-xs font-bold text-blue-950 hover:text-amber-600 transition-colors"
              >
                Leer artículo →
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Banner de Acceso a Calculadoras -->
    <div class="bg-slate-900 text-white rounded-3xl p-8 sm:p-12 shadow-xl flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full">
          Herramientas Útiles
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-3">Calculadoras Financieras en Tiempo Real</h2>
        <p class="text-slate-300 mt-2 text-sm sm:text-base max-w-xl">
          Simula el impacto de los impuestos, calcula tu pensión estimada o proyecta tu ahorro con nuestro interés compuesto.
        </p>
      </div>
      <div>
        <a href="/calculadoras" class="inline-block bg-amber-400 text-slate-900 font-bold px-6 py-3.5 rounded-xl hover:bg-amber-300 transition-colors text-sm shadow-md">
          Acceder a Herramientas →
        </a>
      </div>
    </div>

  </main>
</Layout>
