---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Filtrar artículos válidos y ordenar por fecha más reciente
const articles = allPosts
  .filter(post => post && post.data && (post.data.type === 'article' || !post.data.type))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const top3Articles = articles.slice(0, 3);
const recentArticles = articles.length > 3 ? articles.slice(3, 6) : articles.slice(1, 4);
---

<Layout title="Capitalia Finanzas | Análisis Económico e Inversión Independiente">
  
  <!-- BANNER EN MOVIMIENTO SUPERIOR -->
  {top3Articles.length > 0 && (
    <div class="bg-blue-950 border-b border-blue-900 text-white py-2.5 overflow-hidden shadow-inner">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-amber-400 shrink-0 uppercase tracking-wider">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
          </span>
          Últimas Novedades:
        </div>

        <div class="w-full overflow-hidden ml-4 relative">
          <div class="flex whitespace-nowrap animate-marquee hover:[animation-play-state:paused] gap-12">
            {top3Articles.map((article) => (
              <a href={`/blog/${article.slug}`} class="inline-flex items-center gap-2 text-slate-200 hover:text-amber-400 transition-colors group">
                <span class="px-2 py-0.5 bg-amber-500/20 text-amber-300 font-semibold text-[10px] rounded uppercase border border-amber-500/30">
                  {article.data.category || 'Análisis'}
                </span>
                <span class="font-medium group-hover:underline">
                  {article.data.title}
                </span>
                <span class="text-slate-400 text-xs">({new Date(article.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })})</span>
              </a>
            ))}
            {top3Articles.map((article) => (
              <a href={`/blog/${article.slug}`} class="inline-flex items-center gap-2 text-slate-200 hover:text-amber-400 transition-colors group">
                <span class="px-2 py-0.5 bg-amber-500/20 text-amber-300 font-semibold text-[10px] rounded uppercase border border-amber-500/30">
                  {article.data.category || 'Análisis'}
                </span>
                <span class="font-medium group-hover:underline">
                  {article.data.title}
                </span>
                <span class="text-slate-400 text-xs">({new Date(article.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })})</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-16 bg-white">
    
    <!-- 1. SLIDER / CARRUSEL AUTOMÁTICO DE LOS 3 ARTÍCULOS DESTACADOS -->
    {top3Articles.length > 0 && (
      <section id="hero-slider" class="relative bg-blue-950 rounded-2xl overflow-hidden text-white shadow-xl border border-blue-900 min-h-[380px] flex flex-col justify-between p-6 sm:p-10">
        
        {top3Articles.map((post, index) => (
          <div 
            class={`hero-slide transition-opacity duration-700 ease-in-out grid grid-cols-1 lg:grid-cols-12 gap-8 items-center ${index === 0 ? 'block opacity-100' : 'hidden opacity-0'}`} 
            data-slide-index={index}
          >
            <div class="lg:col-span-7 space-y-4">
              <span class="inline-block px-3 py-1 bg-amber-500/20 text-amber-400 text-xs font-bold tracking-wider uppercase rounded-md border border-amber-500/30">
                {post.data.category || 'Destacado'}
              </span>
              <h1 class="text-2xl sm:text-4xl font-extrabold leading-tight hover:text-amber-400 transition-colors">
                <a href={`/blog/${post.slug}`}>
                  {post.data.title}
                </a>
              </h1>
              <p class="text-slate-200 text-sm sm:text-base leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
              <div class="pt-2 flex items-center gap-6 text-xs text-slate-300">
                <span>{new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                <a href={`/blog/${post.slug}`} class="font-bold text-amber-400 hover:underline">
                  Leer análisis completo →
                </a>
              </div>
            </div>
            {post.data.heroImage && (
              <div class="lg:col-span-5 aspect-video rounded-xl overflow-hidden shadow-lg border border-blue-900/50">
                <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover" />
              </div>
            )}
          </div>
        ))}

        <!-- BOTONES E INDICADORES DEL SLIDER (CAMBIO MANUAL Y AUTO) -->
        <div class="flex items-center justify-between pt-6 border-t border-blue-900/60 mt-4 z-10">
          <div class="flex items-center gap-2">
            {top3Articles.map((_, index) => (
              <button 
                class={`slider-dot w-3 h-3 rounded-full transition-all duration-300 ${index === 0 ? 'bg-amber-400 w-8' : 'bg-slate-700 hover:bg-slate-500'}`}
                data-dot-index={index}
                aria-label={`Ir al artículo ${index + 1}`}
              ></button>
            ))}
          </div>

          <div class="flex items-center gap-2">
            <button id="prevSlide" class="p-2 rounded-lg bg-blue-900/60 hover:bg-amber-500 hover:text-blue-950 transition-colors text-xs font-bold">
              ← Anterior
            </button>
            <button id="nextSlide" class="p-2 rounded-lg bg-blue-900/60 hover:bg-amber-500 hover:text-blue-950 transition-colors text-xs font-bold">
              Siguiente →
            </button>
          </div>
        </div>
      </section>
    )}

    <!-- 2. PARRILLA DE ÚLTIMOS ARTÍCULOS -->
    <section>
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-200">
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
          Últimos Análisis
        </h2>
        <a href="/blog" class="text-xs font-bold text-amber-600 hover:underline">Ver todos los artículos →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentArticles.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
            category={post.data.category || 'General'}
            url={`/blog/${post.slug}`}
            heroImage={post.data.heroImage}
          />
        ))}
      </div>
    </section>

    <!-- 3. SECCIÓN HERRAMIENTAS Y CALCULADORAS -->
    <section id="herramientas" class="bg-blue-50/60 p-8 rounded-2xl border border-blue-100">
      <div class="mb-8">
        <h2 class="text-2xl font-black text-blue-950 tracking-tight">
          Herramientas y Calculadoras Financieras
        </h2>
        <p class="text-slate-600 text-sm mt-1">Calcula tu jubilación, retenciones e impacto fiscal en tiempo real.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard 
          title="Calculadora de Pensión Real" 
          description="Simula tu pensión estimada según las proyecciones demográficas y la inflación acumulada."
          icon="📊"
          url="/herramientas/calculadora-pensiones"
        />
        <ToolCard 
          title="Simulador de Interés
