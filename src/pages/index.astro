---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
		<Header />
		
		<section class="bg-gradient-to-br from-[#053856] to-[#0b4f6c] text-white py-20 px-4">
			<div class="max-w-4xl mx-auto">
				<p class="text-xs md:text-sm uppercase tracking-widest opacity-85 mb-4 font-semibold">
					Tu portal de referencia en economía y gestión
				</p>
				<h1 class="text-3xl md:text-5xl font-bold max-w-2xl leading-tight mb-6">
					Construye tu libertad financiera con estrategias probadas
				</h1>
				<a href="/blog" class="inline-block border-2 border-white text-white px-6 py-3 font-semibold rounded-lg hover:bg-white hover:text-[#0b4f6c] transition-colors">
					Explorar todas las guías
				</a>
			</div>
		</section>

		<main class="max-w-4xl mx-auto px-4 py-12 flex-grow w-full">
			<h2 class="text-2xl font-bold text-slate-900 mb-8 border-b border-slate-200 pb-3">
				Últimas publicaciones y análisis
			</h2>
			<ul class="grid grid-cols-1 md:grid-cols-2 gap-6 list-none p-0 m-0">
				{
					posts.map((post) => (
						<li class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col">
							<a href={`/blog/${post.id}/`} class="p-6 block h-full no-underline text-inherit group">
								<h3 class="text-xl font-bold text-slate-900 group-hover:text-emerald-600 transition-colors mb-2">
									{post.data.title}
								</h3>
								<p class="text-slate-600 text-sm leading-relaxed mb-4">
									{post.data.description}
								</p>
								<span class="text-emerald-600 font-semibold text-sm inline-flex items-center gap-1">
									Leer artículo &rarr;
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>

		<Footer />
	</body>
</html>