---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Capitalia Finanzas - Tu portal de economía y gestión">
    <!-- Hero Principal -->
    <section class="hero">
        <div class="hero-content">
            <span class="badge">Portal Profesional YMYL</span>
            <h1>Construye tu libertad financiera con estrategias probadas</h1>
            <p>Guías prácticas, análisis del mercado en España y herramientas interactivas diseñadas para blindar tu patrimonio.</p>
            <div class="hero-buttons">
                <a href="/calculadora" class="btn-primary">Probar Calculadoras Interactivas &rarr;</a>
                <a href="#articulos" class="btn-secondary">Ver Guías Recientes</a>
            </div>
        </div>
    </section>

    <!-- Cuadrícula de Artículos -->
    <section id="articulos" class="articles-section">
        <div class="section-header">
            <h2>Últimas Guías y Análisis</h2>
        </div>
        
        <div class="articles-grid">
            {
                posts.map((post) => (
                    <article class="article-card">
                        {post.data.heroImage && (
                            <img src={post.data.heroImage.src} alt={post.data.title} />
                        )}
                        <div class="card-content">
                            <h3>
                                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                            </h3>
                            <p>{post.data.description}</p>
                            <a href={`/blog/${post.id}/`} class="read-more">
                                Leer artículo completo &rarr;
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>

    <style>
        .hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            color: white;
            padding: 5rem 1rem;
            text-align: center;
        }
        .hero-content {
            max-width: 800px;
            margin: 0 auto;
        }
        .badge {
            background-color: #2563eb;
            color: white;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            padding: 0.35rem 0.8rem;
            border-radius: 9999px;
            letter-spacing: 0.05em;
        }
        .hero h1 {
            font-size: 2.5rem;
            font-weight: 800;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            line-height: 1.2;
        }
        .hero p {
            font-size: 1.1rem;
            color: #cbd5e1;
            margin-bottom: 2rem;
        }
        .hero-buttons {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .btn-primary {
            background-color: #2563eb;
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-primary:hover {
            background-color: #1d4ed8;
        }
        .btn-secondary {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            text-decoration: none;
            backdrop-filter: blur(4px);
        }
        .btn-secondary:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }
        .articles-section {
            max-width: 1200px;
            margin: 0 auto;
            padding: 4rem 1rem;
        }
        .section-header h2 {
            font-size: 1.75rem;
            font-weight: bold;
            color: #111827;
            border-left: 4px solid #2563eb;
            padding-left: 0.75rem;
            margin-bottom: 2rem;
        }
        .articles-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
        }
        .article-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .article-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
        .article-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .card-content {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            justify-content: space-between;
        }
        .card-content h3 a {
            font-size: 1.15rem;
            font-weight: bold;
            color: #111827;
            text-decoration: none;
            line-height: 1.4;
        }
        .card-content h3 a:hover {
            color: #2563eb;
        }
        .card-content p {
            font-size: 0.95rem;
            color: #4b5563;
            margin: 0.75rem 0 1.5rem 0;
        }
        .read-more {
            color: #2563eb;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
        }
        .read-more:hover {
            text-decoration: underline;
        }
    </style>
</Layout>