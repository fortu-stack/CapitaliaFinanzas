---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Filtrar artículos válidos y ordenar por fecha más reciente
const articles = allPosts
  .filter(post => post && post.data && (post.data.type === 'article' || !post.data.type))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const top3Articles = articles.slice(0, 3);
const featuredPost = articles.length > 0 ? articles[0] : null;
const recentArticles = articles.length > 1 ? articles.slice(1, 4) : [];
---

<Layout title="Capitalia Finanzas | Análisis Económico e Inversión Independiente">
  
  <!-- BANNER EN MOVIMIENTO (CARROUSEL/TICKER) CON LOS 3 ÚLTIMOS ARTÍCULOS -->
  {top3Articles.length > 0 && (
    <div class="bg-blue-950 border-b border-blue-900 text-white py-2.5 overflow-hidden shadow-inner">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-bold text-amber-400 shrink-0 uppercase tracking-wider">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
          </span>
          Últimas Novedades:
        </div>

        <!-- Contenedor del Ticker en movimiento -->
        <div class="w-full overflow-hidden ml-4 relative">
          <div class="flex whitespace-nowrap animate-marquee hover:[animation-play-state:paused] gap-12">
            {top3Articles.map((article) => (
              <a href={`/blog/${article.slug}`} class="inline-flex items-center gap-2 text-slate-200 hover:text-amber-400 transition-colors group">
                <span class="px-2 py-0.5 bg-amber-500/20 text-amber-300 font-semibold text-[10px] rounded uppercase border border-amber-500/30">
                  {article.data.category || 'Análisis'}
                </span>
                <span class="font-medium group-hover:underline">
                  {article.data.title}
                </span>
                <span class="text-slate-400 text-xs">({new Date(article.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })})</span>
              </a>
            ))}
            <!-- Duplicado para efecto loop infinito fluido -->
            {top3Articles.map((article) => (
              <a href={`/blog/${article.slug}`} class="inline-flex items-center gap-2 text-slate-200 hover:text-amber-400 transition-colors group">
                <span class="px-2 py-0.5 bg-amber-500/20 text-amber-300 font-semibold text-[10px] rounded uppercase border border-amber-500/30">
                  {article.data.category || 'Análisis'}
                </span>
                <span class="font-medium group-hover:underline">
                  {article.data.title}
                </span>
                <span class="text-slate-400 text-xs">({new Date(article.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })})</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-16 bg-white">
    
    <!-- 1. HERO / ARTÍCULO DESTACADO (AZUL MARINO OSCURO) -->
    {featuredPost && (
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-blue-950 rounded-2xl overflow-hidden p-6 sm:p-10 text-white shadow-xl border border-blue-900">
        <div class="lg:col-span-7 space-y-4">
          <span class="inline-block px-3 py-1 bg-amber-500/20 text-amber-400 text-xs font-bold tracking-wider uppercase rounded-md border border-amber-500/30">
            {featuredPost.data.category || 'Destacado'}
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight hover:text-amber-400 transition-colors">
            <a href={`/blog/${featuredPost.slug}`}>
              {featuredPost.data.title}
            </a>
          </h1>
          <p class="text-slate-200 text-base sm:text-lg leading-relaxed line-clamp-3">
            {featuredPost.data.description}
          </p>
          <div class="pt-4 flex items-center justify-between text-xs text-slate-300">
            <span>{new Date(featuredPost.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            <a href={`/blog/${featuredPost.slug}`} class="font-bold text-amber-400 hover:underline">
              Leer análisis completo →
            </a>
          </div>
        </div>
        {featuredPost.data.heroImage && (
          <div class="lg:col-span-5 aspect-video rounded-xl overflow-hidden">
            <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} class="w-full h-full object-cover" />
          </div>
        )}
      </section>
    )}

    <!-- 2. PARRILLA DE ÚLTIMOS ARTÍCULOS -->
    <section>
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-200">
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
          Últimos Análisis
        </h2>
        <a href="/blog" class="text-xs font-bold text-amber-600 hover:underline">Ver todos los artículos →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentArticles.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
            category={post.data.category || 'General'}
            url={`/blog/${post.slug}`}
            heroImage={post.data.heroImage}
          />
        ))}
      </div>
    </section>

    <!-- 3. SECCIÓN HERRAMIENTAS Y CALCULADORAS -->
    <section id="herramientas" class="bg-blue-50/60 p-8 rounded-2xl border border-blue-100">
      <div class="mb-8">
        <h2 class="text-2xl font-black text-blue-950 tracking-tight">
          Herramientas y Calculadoras Financieras
        </h2>
        <p class="text-slate-600 text-sm mt-1">Calcula tu jubilación, retenciones e impacto fiscal en tiempo real.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <ToolCard 
          title="Calculadora de Pensión Real" 
          description="Simula tu pensión estimada según las proyecciones demográficas y la inflación acumulada."
          icon="📊"
          url="/herramientas/calculadora-pensiones"
        />
        <ToolCard 
          title="Simulador de Interés Compuesto" 
          description="Descubre cuánto valdrá tu ahorro mensual invirtiendo a largo plazo."
          icon="📈"
          url="/herramientas/interes-compuesto"
        />
        <ToolCard 
          title="Calculadora del Impacto del MEI" 
          description="Calcula cuánto estás aportando mes a mes por el Mecanismo de Equidad Intergeneracional."
          icon="🧮"
          url="/herramientas/calculadora-mei"
        />
      </div>
    </section>

  </main>

  <style>
    @keyframes marquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      display: flex;
      width: max-content;
      animation: marquee 25s linear infinite;
    }
  </style>
</Layout>
