---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Ordenar artículos por fecha (más recientes primero)
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

// Función segura para obtener la URL limpia del artículo
function getPostSlug(post: any): string {
  if (post.slug) return post.slug;
  if (post.id) return post.id.replace(/\.(md|mdx)$/, '');
  return '';
}

// Función para clasificar categorías automáticamente
function getCategory(title: string): string {
  const t = title.toLowerCase();
  if (t.includes('vivienda') || t.includes('alquilar') || t.includes('piso') || t.includes('inmobiliario') || t.includes('alquileres')) {
    return 'Vivienda e Inmobiliario';
  }
  if (t.includes('pirámide') || t.includes('pensiones') || t.includes('herencias') || t.includes('impuestos') || t.includes('renta') || t.includes('deducciones') || t.includes('fiscal') || t.includes('tributación')) {
    return 'Fiscalidad y Pensiones';
  }
  if (t.includes('invertir') || t.includes('rentabilidad') || t.includes('fondos indexados') || t.includes('interés compuesto')) {
    return 'Inversión y Patrimonio';
  }
  if (t.includes('mileurismo') || t.includes('carrera') || t.includes('estudiar')) {
    return 'Empleo y Sociedad';
  }
  return 'Finanzas Personales';
}

const featuredPosts = sortedPosts.slice(0, 3); // Para el carrusel en movimiento
const tickerPosts = sortedPosts.slice(0, 5);   // Para la barra de novedades superior
const gridPosts = sortedPosts.slice(3, 9);     // Para la rejilla de tarjetas
---

<Layout title="Capitalia Finanzas | Análisis Económico, Vivienda e Inversión" description="Análisis independiente sobre economía, fiscalidad, vivienda y finanzas personales en España.">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- BANNER 1: Ticker / Cinta Superior en Movimiento de Últimas Novedades -->
    <div class="bg-blue-950 text-white rounded-2xl p-3 sm:p-4 mb-8 shadow-md flex items-center overflow-hidden border border-blue-900">
      <span class="bg-amber-400 text-blue-950 text-xs font-black uppercase px-3 py-1 rounded-md tracking-wider whitespace-nowrap z-10 mr-4 shadow">
        ● ÚLTIMAS NOVEDADES:
      </span>
      <div class="overflow-hidden relative w-full">
        <div class="inline-flex whitespace-nowrap animate-marquee gap-8 items-center text-xs sm:text-sm font-medium">
          {tickerPosts.map(post => (
            <a href={`/blog/${getPostSlug(post)}`} class="hover:text-amber-400 transition-colors flex items-center gap-2">
              <span class="text-slate-300">{post.data.title}</span>
              <span class="text-slate-500 font-normal">({new Date(post.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })})</span>
              <span class="text-amber-400 ml-4">•</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- BANNER 2: Hero Destacado / Carrusel Interactivo en Movimiento -->
    <div class="relative bg-blue-950 text-white rounded-3xl p-6 sm:p-10 mb-12 shadow-2xl border border-blue-900 overflow-hidden min-h-[320px] flex flex-col justify-between">
      <div class="relative z-10 max-w-3xl">
        <div id="carousel-slides">
          {featuredPosts.map((post, index) => (
            <div class={`carousel-slide ${index === 0 ? 'block' : 'hidden'} transition-all duration-500`} data-index={index}>
              <span class="inline-block font-bold text-xs uppercase tracking-wider text-amber-400 bg-amber-400/10 px-3 py-1 rounded-md mb-4 border border-amber-400/20">
                {getCategory(post.data.title)}
              </span>
              <h1 class="text-2xl sm:text-4xl font-black text-white leading-tight mb-4 tracking-tight">
                <a href={`/blog/${getPostSlug(post)}`} class="hover:text-amber-300 transition-colors">
                  {post.data.title}
                </a>
              </h1>
              <p class="text-slate-300 text-sm sm:text-base leading-relaxed line-clamp-3 mb-6">
                {post.data.description}
              </p>
              <div class="flex items-center gap-4">
                <span class="text-xs text-slate-400">
                  {new Date(post.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
                <a href={`/blog/${getPostSlug(post)}`} class="inline-flex items-center text-xs sm:text-sm font-bold text-amber-400 hover:text-amber-300 transition-colors">
                  Leer análisis completo →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Controles e indicadores del Carrusel -->
      <div class="relative z-10 flex items-center justify-between mt-8 pt-6 border-t border-blue-900/60">
        <!-- Puntos indicadores -->
        <div class="flex items-center gap-2" id="carousel-dots">
          {featuredPosts.map((_, index) => (
            <button 
              class={`w-3 h-3 rounded-full transition-all ${index === 0 ? 'bg-amber-400 w-8' : 'bg-slate-700 hover:bg-slate-500'}`}
              data-target={index}
              aria-label={`Ir a diapositiva ${index + 1}`}
            ></button>
          ))}
        </div>

        <!-- Botones Anterior / Siguiente -->
        <div class="flex items-center gap-2">
          <button id="prev-btn" class="px-3 py-1.5 rounded-lg bg-blue-900/80 hover:bg-amber-400 hover:text-blue-950 text-xs font-bold transition-all border border-blue-800">
            ← Anterior
          </button>
          <button id="next-btn" class="px-3 py-1.5 rounded-lg bg-blue-900/80 hover:bg-amber-400 hover:text-blue-950 text-xs font-bold transition-all border border-blue-800">
            Siguiente →
          </button>
        </div>
      </div>
    </div>

    <!-- Título de la Sección Principal -->
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Análisis y Actualidad Financiera
      </h2>
      <p class="mt-1 text-slate-600 text-sm sm:text-base">
        Descubre nuestros últimos estudios sobre economía, vivienda, impuestos y patrimonio.
      </p>
    </div>

    <!-- Rejilla de Artículos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {gridPosts.map((post) => {
        const postUrl = getPostSlug(post);
        const cat = getCategory(post.data.title);
        return (
          <article class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden hover:shadow-md transition-all flex flex-col justify-between">
            <div class="p-6">
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md">
                  {cat}
                </span>
                <time class="text-slate-400 font-medium">
                  {new Date(post.data.pubDate).toLocaleDateString('es-ES', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  })}
                </time>
              </div>

              <h3 class="text-lg font-bold text-slate-900 hover:text-blue-950 transition-colors line-clamp-2">
                <a href={`/blog/${postUrl}`}>
                  {post.data.title}
                </a>
              </h3>

              <p class="mt-2 text-slate-600 text-sm leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
            </div>

            <div class="px-6 pb-6 pt-2">
              <a
                href={`/blog/${postUrl}`}
                class="inline-flex items-center text-xs font-bold text-blue-950 hover:text-amber-600 transition-colors"
              >
                Leer artículo →
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Banner de Acceso a Calculadoras -->
    <div class="bg-slate-900 text-white rounded-3xl p-8 sm:p-12 shadow-xl flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 bg-amber-400/10 px-3 py-1 rounded-full">
          Herramientas Útiles
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-3">Calculadoras Financieras en Tiempo Real</h2>
        <p class="text-slate-300 mt-2 text-sm sm:text-base max-w-xl">
          Simula el impacto de los impuestos, calcula tu pensión estimada o proyecta tu ahorro con nuestro interés compuesto.
        </p>
      </div>
      <div>
        <a href="/calculadoras" class="inline-block bg-amber-400 text-slate-900 font-bold px-6 py-3.5 rounded-xl hover:bg-amber-300 transition-colors text-sm shadow-md whitespace-nowrap">
          Acceder a Herramientas →
        </a>
      </div>
    </div>

  </main>
</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: inline-flex;
    animation: marquee 25s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.carousel-slide');
  const dots = document.querySelectorAll('#carousel-dots button');
  const totalSlides = slides.length;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('hidden');
        slide.classList.add('block');
      } else {
        slide.classList.remove('block');
        slide.classList.add('hidden');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.className = 'w-8 h-3 bg-amber-400 rounded-full transition-all';
      } else {
        dot.className = 'w-3 h-3 bg-slate-700 hover:bg-slate-500 rounded-full transition-all';
      }
    });

    currentSlide = index;
  }

  document.getElementById('next-btn')?.addEventListener('click', () => {
    const next = (currentSlide + 1) % totalSlides;
    showSlide(next);
  });

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    const prev = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(prev);
  });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => showSlide(i));
  });

  // Rotación automática cada 6 segundos
  setInterval(() => {
    const next = (currentSlide + 1) % totalSlides;
    showSlide(next);
  }, 6000);
</script>
