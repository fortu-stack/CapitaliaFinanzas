---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Filtrar solo los contenidos de tipo artículo
const articles = allPosts.filter(post => post.data.type === 'article' || !post.data.type);

const viviendaArticles = articles.filter(post => post.data.category === 'vivienda');
const fiscalidadArticles = articles.filter(post => post.data.category === 'fiscalidad');
const inversionArticles = articles.filter(post => post.data.category === 'inversion');

const categories = [
  { title: '🏠 Vivienda y Alquiler', posts: viviendaArticles, slug: 'vivienda' },
  { title: '⚖️ Fiscalidad e Impuestos', posts: fiscalidadArticles, slug: 'fiscalidad' },
  { title: '📈 Inversión y Ahorro', posts: inversionArticles, slug: 'inversion' },
];
---

<main style="max-width: 72rem; margin: 0 auto; padding: 2.5rem 1rem; font-family: system-ui, sans-serif;">
  <header style="border-bottom: 1px solid #e2e8f0; padding-bottom: 1.5rem; margin-bottom: 2.5rem;">
    <h1 style="font-size: 2.25rem; font-weight: 800; color: #0f172a; margin: 0 0 0.5rem 0;">Artículos y Análisis</h1>
    <p style="color: #64748b; font-size: 1.125rem; margin: 0;">Explora todas las publicaciones clasificadas por temática financiera.</p>
  </header>

  <div style="display: flex; flex-direction: column; gap: 3rem;">
    {categories.map((cat) => (
      <section style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.75rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin: 0 0 1.25rem 0; padding-bottom: 0.75rem; border-bottom: 2px solid #f1f5f9;">
          {cat.title}
        </h2>

        {cat.posts.length > 0 ? (
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem;">
            {cat.posts.map((post) => (
              <li style="border-bottom: 1px solid #f8fafc; padding-bottom: 0.75rem;">
                <a href={`/blog/${post.slug}/`} style="text-decoration: none; display: block;">
                  <h3 style="font-size: 1.125rem; font-weight: 600; color: #0f172a; margin: 0 0 0.25rem 0;" onmouseover="this.style.color='#2563eb'" onmouseout="this.style.color='#0f172a'">
                    {post.data.title}
                  </h3>
                  <p style="font-size: 0.875rem; color: #64748b; margin: 0; line-height: 1.4;">
                    {post.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p style="color: #94a3b8; font-style: italic; margin: 0;">Próximamente nuevos artículos en esta categoría.</p>
        )}
      </section>
    ))}
  </div>
</main>
