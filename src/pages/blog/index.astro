---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Misma función de clasificación
function getCategory(title: string): string {
  const t = title.toLowerCase();
  if (t.includes('vivienda') || t.includes('alquilar') || t.includes('piso') || t.includes('inmobiliario') || t.includes('alquileres')) {
    return 'Vivienda e Inmobiliario';
  }
  if (t.includes('pirámide') || t.includes('pensiones') || t.includes('herencias') || t.includes('impuestos') || t.includes('renta') || t.includes('deducciones') || t.includes('fiscal') || t.includes('tributación')) {
    return 'Fiscalidad y Pensiones';
  }
  if (t.includes('invertir') || t.includes('rentabilidad') || t.includes('fondos indexados') || t.includes('interés compuesto')) {
    return 'Inversión y Patrimonio';
  }
  if (t.includes('mileurismo') || t.includes('carrera') || t.includes('estudiar')) {
    return 'Empleo y Sociedad';
  }
  return 'Finanzas Personales';
}

const categoriesMap: Record<string, typeof allPosts> = {
  'Vivienda e Inmobiliario': [],
  'Finanzas Personales': [],
  'Inversión y Patrimonio': [],
  'Fiscalidad y Pensiones': [],
  'Empleo y Sociedad': []
};

allPosts.forEach(post => {
  const cat = getCategory(post.data.title);
  if (categoriesMap[cat]) {
    categoriesMap[cat].push(post);
  } else {
    categoriesMap['Finanzas Personales'].push(post);
  }
});
---

<Layout title="Artículos y Análisis | Capitalia Finanzas" description="Análisis económico, finanzas personales, inversión y fiscalidad.">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Encabezado -->
    <div class="mb-12 text-center md:text-left">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Artículos y Análisis
      </h1>
      <p class="mt-2 text-lg text-slate-600">
        Explora todos nuestros artículos organizados por categorías temáticas.
      </p>
    </div>

    <!-- Contenedor por Categorías -->
    <div class="space-y-16">
      {Object.entries(categoriesMap).map(([categoryName, posts]) => (
        posts.length > 0 && (
          <section class="border-b border-slate-200 pb-12 last:border-0">
            
            <!-- Título de Categoría -->
            <div class="flex items-center gap-3 mb-6">
              <h2 class="text-2xl font-bold text-blue-950 tracking-tight">
                {categoryName}
              </h2>
              <span class="text-xs font-bold bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full">
                {posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}
              </span>
            </div>

            <!-- Rejilla de Artículos de esta Categoría -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {posts.map((post) => (
                <article class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden hover:shadow-md transition-all flex flex-col justify-between">
                  <div class="p-6">
                    <div class="flex items-center justify-between text-xs mb-3">
                      <span class="font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-2.5 py-1 rounded-md">
                        {categoryName}
                      </span>
                      <time class="text-slate-400 font-medium">
                        {new Date(post.data.pubDate).toLocaleDateString('es-ES', {
                          day: 'numeric',
                          month: 'short',
                          year: 'numeric'
                        })}
                      </time>
                    </div>

                    <h3 class="text-lg font-bold text-slate-900 hover:text-blue-950 transition-colors line-clamp-2">
                      <a href={`/blog/${post.slug}`}>
                        {post.data.title}
                      </a>
                    </h3>

                    <p class="mt-2 text-slate-600 text-sm leading-relaxed line-clamp-3">
                      {post.data.description}
                    </p>
                  </div>

                  <div class="px-6 pb-6 pt-2">
                    <a
                      href={`/blog/${post.slug}`}
                      class="inline-flex items-center text-xs font-bold text-blue-950 hover:text-amber-600 transition-colors"
                    >
                      Leer artículo →
                    </a>
                  </div>
                </article>
              ))}
            </div>

          </section>
        )
      ))}
    </div>

  </main>
</Layout>
