---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

// Filtrar artículos que sean de tipo 'article' o sin tipo especificado, ordenados por fecha
const articles = allPosts
  .filter((post) => post && post.data && (post.data.type === "article" || !post.data.type))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="Artículos y Análisis | Capitalia Finanzas">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8 bg-white">
    <header class="border-b border-slate-200 pb-8">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Análisis y Archivo Económico
      </h1>
      <p class="text-slate-600 text-base mt-2">
        Todos nuestros informes, análisis de fiscalidad, pensiones y estrategia de inversión independiente.
      </p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pt-4">
      {
        articles.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
            category={post.data.category || "General"}
            url={`/blog/${post.slug}`}
            heroImage={post.data.heroImage}
          />
        ))
      }
    </section>
  </main>
</Layout>
