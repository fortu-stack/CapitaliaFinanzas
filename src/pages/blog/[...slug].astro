---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug || post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function getCategory(title: string): string {
  if (post.data.category) return post.data.category;
  const t = title.toLowerCase();
  if (t.includes('vivienda') || t.includes('alquilar') || t.includes('piso') || t.includes('inmobiliario') || t.includes('alquileres')) {
    return 'Vivienda e Inmobiliario';
  }
  if (t.includes('pirámide') || t.includes('pensiones') || t.includes('herencias') || t.includes('impuestos') || t.includes('renta') || t.includes('deducciones') || t.includes('fiscal') || t.includes('tributación')) {
    return 'Fiscalidad y Pensiones';
  }
  if (t.includes('invertir') || t.includes('rentabilidad') || t.includes('fondos indexados') || t.includes('interés compuesto')) {
    return 'Inversión y Patrimonio';
  }
  if (t.includes('mileurismo') || t.includes('carrera') || t.includes('estudiar')) {
    return 'Empleo y Sociedad';
  }
  return 'Finanzas Personales';
}

const categoryName = getCategory(post.data.title);
---

<Layout title={`${post.data.title} | Capitalia Finanzas`} description={post.data.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Cabecera del Artículo -->
    <header class="mb-12 text-center border-b border-slate-200 pb-10">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 bg-amber-50 px-3 py-1 rounded-md">
          {categoryName}
        </span>
        <span class="text-slate-300">•</span>
        <time class="text-xs font-medium text-slate-500">
          {new Date(post.data.pubDate).toLocaleDateString('es-ES', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          })}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight max-w-3xl mx-auto">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
          {post.data.description}
        </p>
      )}
    </header>

    <!-- Contenido del Artículo Estilizado -->
    <div class="article-content max-w-3xl mx-auto text-slate-800 text-base sm:text-lg leading-relaxed">
      <Content />
    </div>

    <!-- Pie del Artículo -->
    <footer class="mt-16 pt-8 border-t border-slate-200 flex justify-between items-center max-w-3xl mx-auto">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-blue-950 hover:text-amber-600 transition-colors">
        ← Volver a todos los artículos
      </a>
    </footer>

  </article>
</Layout>

<style is:global>
  /* Estilos para maquetar el texto del Markdown perfectamente */
  .article-content p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }

  .article-content h1,
  .article-content h2,
  .article-content h3,
  .article-content h4 {
    color: #0f172a;
    font-weight: 800;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .article-content h1 { font-size: 2rem; }
  .article-content h2 { font-size: 1.65rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; }
  .article-content h3 { font-size: 1.35rem; }

  .article-content strong {
    color: #0f172a;
    font-weight: 700;
  }

  .article-content hr {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    border: 0;
    border-top: 1px solid #e2e8f0;
  }

  .article-content ul,
  .article-content ol {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-content ul { list-style-type: disc; }
  .article-content ol { list-style-type: decimal; }

  .article-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .article-content blockquote {
    border-left: 4px solid #f59e0b;
    background-color: #fffbeb;
    padding: 1rem 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    color: #334155;
  }
</style>
