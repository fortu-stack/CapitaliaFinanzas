---
const today = new Date();
---

<footer>
    &copy; {today.getFullYear()} Capitalia Finanzas. Todos los derechos reservados.
    <div class="footer-links">
        <a href="/privacidad">Política de Privacidad</a>
        <span class="separator">·</span>
        <a href="/cookies">Política de Cookies</a>
    </div>
</footer>

<style>
    footer {
        padding: 2.5rem 2rem;
        text-align: center;
        background: #ffffff;
        color: #555;
        border-top: 1px solid #eaeaea;
        margin-top: 4rem;
    }
    .footer-links {
        margin-top: 0.75rem;
        display: flex;
        justify-content: center;
        gap: 1rem;
        align-items: center;
    }
    .footer-links a {
        color: #0b4f6c;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
    }
    .footer-links a:hover {
        text-decoration: underline;
    }
    .separator {
        color: #ccc;
    }
</style>