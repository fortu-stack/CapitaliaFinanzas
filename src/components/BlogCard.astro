---
interface Props {
  title: string;
  description: string;
  pubDate: string;
  category: string;
  url: string;
  heroImage?: string;
}

const { title, description, pubDate, category, url, heroImage } = Astro.props;
---

<article class="group flex flex-col bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
  {heroImage && (
    <a href={url} class="overflow-hidden aspect-video bg-slate-100 dark:bg-slate-800">
      <img 
        src={heroImage} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" 
        loading="lazy" 
      />
    </a>
  )}
  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-center justify-between text-xs font-semibold tracking-wider text-amber-600 dark:text-amber-400 uppercase mb-3">
      <span>{category}</span>
      <span class="text-slate-400 font-normal border-l border-slate-200 dark:border-slate-700 pl-2">{pubDate}</span>
    </div>
    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-amber-600 transition-colors duration-200 leading-snug mb-2">
      <a href={url}>
        {title}
      </a>
    </h3>
    <p class="text-slate-600 dark:text-slate-400 text-sm line-clamp-2 leading-relaxed mb-4 flex-1">
      {description}
    </p>
    <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-medium text-slate-500">
      <span class="group-hover:translate-x-1 transition-transform duration-200 text-amber-600 dark:text-amber-400 flex items-center gap-1">
        Leer artículo →
      </span>
    </div>
  </div>
</article>
