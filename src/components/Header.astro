---
import { SITE_TITLE } from '../consts';
---

<header style="background-color: #ffffff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 50; font-family: system-ui, sans-serif;">
    <!-- Fila superior -->
    <div style="max-width: 72rem; margin: 0 auto; padding: 0 1rem; height: 5rem; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f1f5f9;">
        <a href="/" style="font-size: 1.5rem; font-weight: 900; color: #0f172a; text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: #059669;">■</span> {SITE_TITLE}
        </a>
        <div style="font-size: 0.875rem; color: #475569; font-weight: 500;">
            Portal Profesional
        </div>
    </div>

    <!-- Barra de navegación principal -->
    <div style="background-color: #ffffff; border-bottom: 1px solid #e2e8f0;">
        <nav style="max-width: 72rem; margin: 0 auto; padding: 0 1rem; display: flex; align-items: center; gap: 2rem; height: 3rem; font-size: 0.875rem; font-weight: 600; color: #334155; overflow-x: auto;">
            <a href="/" style="color: #059669; border-bottom: 2px solid #059669; height: 100%; display: flex; align-items: center; text-decoration: none;">Inicio</a>
            <a href="/blog" style="color: inherit; text-decoration: none; height: 100%; display: flex; align-items: center;">Mercados</a>
            <a href="#" style="color: inherit; text-decoration: none; height: 100%; display: flex; align-items: center;">Inversión</a>
            <a href="#" style="color: inherit; text-decoration: none; height: 100%; display: flex; align-items: center;">Guías y Análisis</a>
            <a href="#" style="color: inherit; text-decoration: none; height: 100%; display: flex; align-items: center;">Herramientas</a>
        </nav>
    </div>

    <!-- Barra secundaria de subcategorías -->
    <div style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; font-size: 0.75rem; font-weight: 500; color: #64748b;">
        <div style="max-width: 72rem; margin: 0 auto; padding: 0 1rem; height: 2.25rem; display: flex; align-items: center; gap: 1.5rem; overflow-x: auto;">
            <span style="color: #1e293b; font-weight: 600;">Temas clave:</span>
            <a href="#" style="color: inherit; text-decoration: none;">Estrategias</a>
            <a href="#" style="color: inherit; text-decoration: none;">Dividendos</a>
            <a href="#" style="color: inherit; text-decoration: none;">Fiscalidad</a>
            <a href="#" style="color: inherit; text-decoration: none;">Fondos Indexados</a>
        </div>
    </div>
</header>