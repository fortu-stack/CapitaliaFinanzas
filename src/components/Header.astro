---
import { SITE_TITLE } from '../consts';
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
    <!-- Fila superior: Logotipo corporativo -->
    <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between border-b border-slate-100">
        <a href="/" class="text-2xl font-black tracking-tight text-slate-900 flex items-center gap-2 no-underline">
            <span class="text-emerald-600">■</span> {SITE_TITLE}
        </a>
        <div class="hidden md:flex items-center text-sm text-slate-600 font-medium">
            <span class="hover:text-emerald-600 cursor-pointer">Portal Profesional</span>
        </div>
    </div>

    <!-- Barra de navegación principal -->
    <div class="bg-white border-b border-slate-200">
        <nav class="max-w-6xl mx-auto px-4 flex items-center gap-8 h-12 text-sm font-semibold text-slate-700 overflow-x-auto">
            <a href="/" class="text-emerald-600 border-b-2 border-emerald-600 h-full flex items-center no-underline">Inicio</a>
            <a href="/blog" class="hover:text-emerald-600 h-full flex items-center transition-colors no-underline">Mercados</a>
            <a href="#" class="hover:text-emerald-600 h-full flex items-center transition-colors no-underline">Inversión</a>
            <a href="#" class="hover:text-emerald-600 h-full flex items-center transition-colors no-underline">Guías y Análisis</a>
            <a href="#" class="hover:text-emerald-600 h-full flex items-center transition-colors no-underline">Herramientas</a>
        </nav>
    </div>

    <!-- Barra secundaria de subcategorías -->
    <div class="bg-slate-50 border-b border-slate-200 text-xs font-medium text-slate-500">
        <div class="max-w-6xl mx-auto px-4 h-9 flex items-center gap-6 overflow-x-auto">
            <span class="text-slate-800 font-semibold">Temas clave:</span>
            <a href="#" class="hover:text-emerald-600 no-underline">Estrategias</a>
            <a href="#" class="hover:text-emerald-600 no-underline">Dividendos</a>
            <a href="#" class="hover:text-emerald-600 no-underline">Fiscalidad</a>
            <a href="#" class="hover:text-emerald-600 no-underline">Fondos Indexados</a>
        </div>
    </div>
</header>