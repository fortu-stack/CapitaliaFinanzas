---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

function getCategory(title: string): string {
  const t = title.toLowerCase();
  if (t.includes('vivienda') || t.includes('alquilar') || t.includes('piso') || t.includes('inmobiliario') || t.includes('alquileres')) {
    return 'Vivienda e Inmobiliario';
  }
  if (t.includes('pirámide') || t.includes('pensiones') || t.includes('herencias') || t.includes('impuestos') || t.includes('renta') || t.includes('deducciones') || t.includes('fiscal') || t.includes('tributación')) {
    return 'Fiscalidad y Pensiones';
  }
  if (t.includes('invertir') || t.includes('rentabilidad') || t.includes('fondos indexados') || t.includes('interés compuesto')) {
    return 'Inversión y Patrimonio';
  }
  if (t.includes('mileurismo') || t.includes('carrera') || t.includes('estudiar')) {
    return 'Empleo y Sociedad';
  }
  return 'Finanzas Personales';
}

const categoriesMap: Record<string, typeof allPosts> = {
  'Vivienda e Inmobiliario': [],
  'Finanzas Personales': [],
  'Inversión y Patrimonio': [],
  'Fiscalidad y Pensiones': [],
  'Empleo y Sociedad': []
};

allPosts.forEach(post => {
  const cat = getCategory(post.data.title);
  if (categoriesMap[cat]) {
    categoriesMap[cat].push(post);
  } else {
    categoriesMap['Finanzas Personales'].push(post);
  }
});
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <span class="font-black text-xl tracking-wider text-slate-900 uppercase">CAPITALIA</span>
      <span class="text-xs font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded">FINANZAS</span>
    </a>

    <!-- Navegación principal -->
    <nav class="hidden md:flex items-center gap-8 font-medium text-sm text-slate-700">
      <a href="/" class="hover:text-amber-600 transition-colors">Inicio</a>
      
      <!-- Menú Desplegable Nivel 1: Artículos -->
      <div class="relative group py-6">
        <a href="/blog" class="flex items-center gap-1 hover:text-amber-600 transition-colors">
          Artículos
          <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <!-- Lista de Categorías (Nivel 1) -->
        <div class="absolute left-0 top-full w-64 bg-white rounded-2xl shadow-xl border border-slate-200 py-3 hidden group-hover:block transition-all z-50">
          <ul class="space-y-1">
            {Object.entries(categoriesMap).map(([categoryName, posts]) => (
              <li class="relative group/sub px-2">
                <div class="flex items-center justify-between w-full px-3 py-2 text-xs font-bold text-slate-700 hover:text-amber-600 hover:bg-amber-50 rounded-xl cursor-pointer transition-colors">
                  <span>{categoryName}</span>
                  <span class="text-[10px] text-slate-400 font-normal">({posts.length}) ›</span>
                </div>

                {posts.length > 0 && (
                  <div class="absolute left-full top-0 ml-1 w-80 bg-white rounded-2xl shadow-2xl border border-slate-200 p-3 hidden group-hover/sub:block transition-all max-h-96 overflow-y-auto">
                    <div class="text-[10px] font-extrabold text-amber-800 uppercase tracking-wider mb-2 px-2 pb-1 border-b border-slate-100">
                      {categoryName}
                    </div>
                    <ul class="space-y-1">
                      {posts.map(post => {
                        const slugUrl = (post as any).slug || (post as any).id?.replace(/\.mdx?$/, '');
                        return (
                          <li>
                            <a 
                              href={`/blog/${slugUrl}`} 
                              class="block text-xs text-slate-600 hover:text-blue-950 hover:bg-slate-50 px-2 py-1.5 rounded-lg transition-colors leading-snug"
                            >
                              {post.data.title}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href="/calculadoras" class="hover:text-amber-600 transition-colors">Calculadoras</a>
    </nav>

    <!-- Botón derecho (Actualizado a Contacto) -->
    <div>
      <a href="mailto:contacto@capitaliafinanzas.com" class="text-xs font-bold text-slate-600 hover:text-slate-900 transition-colors">
        Contacto
      </a>
    </div>

  </div>
</header>
