---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Función automática para clasificar sin tocar el Frontmatter
function getCategory(title: string): string {
  const t = title.toLowerCase();
  if (t.includes('vivienda') || t.includes('alquilar') || t.includes('piso') || t.includes('inmobiliario') || t.includes('alquileres')) {
    return 'Vivienda e Inmobiliario';
  }
  if (t.includes('pirámide') || t.includes('pensiones') || t.includes('herencias') || t.includes('impuestos') || t.includes('renta') || t.includes('deducciones') || t.includes('fiscal') || t.includes('tributación')) {
    return 'Fiscalidad y Pensiones';
  }
  if (t.includes('invertir') || t.includes('rentabilidad') || t.includes('fondos indexados') || t.includes('interés compuesto')) {
    return 'Inversión y Patrimonio';
  }
  if (t.includes('mileurismo') || t.includes('carrera') || t.includes('estudiar')) {
    return 'Empleo y Sociedad';
  }
  return 'Finanzas Personales';
}

// Agrupar artículos por categoría automáticamente
const categoriesMap: Record<string, typeof allPosts> = {
  'Vivienda e Inmobiliario': [],
  'Finanzas Personales': [],
  'Inversión y Patrimonio': [],
  'Fiscalidad y Pensiones': [],
  'Empleo y Sociedad': []
};

allPosts.forEach(post => {
  const cat = getCategory(post.data.title);
  if (categoriesMap[cat]) {
    categoriesMap[cat].push(post);
  } else {
    categoriesMap['Finanzas Personales'].push(post);
  }
});
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <span class="font-black text-xl tracking-wider text-slate-900 uppercase">CAPITALIA</span>
      <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded">FINANZAS</span>
    </a>

    <!-- Navegación principal -->
    <nav class="hidden md:flex items-center gap-8 font-medium text-sm text-slate-700">
      <a href="/" class="hover:text-amber-600 transition-colors">Inicio</a>
      
      <!-- Menú Desplegable de Artículos -->
      <div class="relative group py-4">
        <button class="flex items-center gap-1 hover:text-amber-600 transition-colors focus:outline-none">
          Artículos
          <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown con Categorías y Artículos -->
        <div class="absolute left-0 top-full w-96 bg-white rounded-2xl shadow-xl border border-slate-200 py-4 px-3 hidden group-hover:block transition-all max-h-[80vh] overflow-y-auto">
          <div class="space-y-4">
            {Object.entries(categoriesMap).map(([categoryName, posts]) => (
              posts.length > 0 && (
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-amber-600 px-3 py-1 bg-amber-50 rounded-md mb-1">
                    {categoryName}
                  </h3>
                  <ul class="space-y-1">
                    {posts.map(post => (
                      <li>
                        <a href={`/blog/${post.slug}`} class="block text-xs text-slate-600 hover:text-blue-950 hover:bg-slate-50 px-3 py-1.5 rounded transition-colors line-clamp-1">
                          {post.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            ))}
          </div>
        </div>
      </div>

      <a href="/calculadoras" class="hover:text-amber-600 transition-colors">Calculadoras</a>
    </nav>

    <!-- Botón derecho -->
    <div>
      <a href="/portal-profesional" class="text-xs font-bold text-slate-600 hover:text-slate-900 transition-colors">
        Portal Profesional
      </a>
    </div>

  </div>
</header>
