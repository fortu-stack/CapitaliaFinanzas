---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Capitalia Finanzas | Análisis Económico e Inversión Independiente",
  description = "Análisis financiero independiente, guías de inversión, fiscalidad y herramientas para optimizar tu patrimonio." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col justify-between">
    
    <div>
      <Header />
      <slot />
    </div>

    <Footer />

  </body>
</html>
