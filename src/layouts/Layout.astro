---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Capitalia Finanzas | Análisis Económico e Inversión Independiente", 
  description = "Análisis económico riguroso, fiscalidad, pensiones y herramientas financieras independientes." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Tailwind CSS CDN para renderizado inmediato -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'media',
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#fffbe1',
                500: '#f59e0b',
                600: '#d97706',
                900: '#78350f',
              }
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-slate-100 dark:bg-slate-950 text-slate-800 dark:text-slate-100 antialiased min-h-screen flex flex-col selection:bg-amber-500 selection:text-white">
    
    <!-- HEADER / NAVEGACIÓN -->
    <header class="sticky top-0 z-50 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-2xl">📈</span>
          <span class="font-black text-xl tracking-tight text-slate-900 dark:text-white group-hover:text-amber-500 transition-colors">
            CAPITALIA<span class="text-amber-500">.</span>
          </span>
        </a>

        <nav class="flex items-center gap-6 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <a href="/" class="hover:text-amber-500 transition-colors">Inicio</a>
          <a href="/blog" class="hover:text-amber-500 transition-colors">Artículos</a>
          <a href="/#herramientas" class="hover:text-amber-500 transition-colors">Herramientas</a>
        </nav>
      </div>
    </header>

    <!-- CONTENIDO PRINCIPAL DE LA PÁGINA -->
    <div class="flex-1">
      <slot />
    </div>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 py-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-2">
          <span class="text-xl">📈</span>
          <span class="font-bold text-white tracking-tight">CAPITALIA FINANZAS</span>
        </div>
        <p class="text-xs text-slate-500 text-center md:text-left">
          © {new Date().getFullYear()} Capitalia Finanzas. Análisis independiente. No constituye asesoramiento financiero.
        </p>
        <div class="flex gap-4 text-xs font-medium">
          <a href="/blog" class="hover:text-amber-400">Blog</a>
          <a href="#" class="hover:text-amber-400">Aviso Legal</a>
        </div>
      </div>
    </footer>

  </body>
</html>
