---
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Capitalia Finanzas | Análisis Económico e Inversión Independiente",
  description = "Análisis financiero independiente, guías de inversión, fiscalidad y herramientas para optimizar tu patrimonio." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- CARGA DIRECTA DE TAILWIND CSS PARA RESTAURAR EL DISEÑO AL INSTANTE -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col justify-between">
    
    <div>
      <Header />
      <slot />
    </div>

    <!-- FOOTER LEGAL COMPLETO Y RECTIFICADO -->
    <footer class="bg-blue-950 text-slate-300 border-t border-blue-900 py-8 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs">
        
        <!-- BRANDING Y DISCLAIMER FINANCIERO -->
        <div class="flex flex-col gap-1 max-w-2xl text-center md:text-left">
          <span class="font-black text-white text-sm tracking-wider uppercase">CAPITALIA FINANZAS</span>
          <p class="text-slate-400 leading-relaxed">
            © 2026 Capitalia Finanzas. Análisis económico, fiscal e inversión independiente.
            <span class="block text-slate-500 text-[11px] mt-0.5">
              <strong>Aviso legal:</strong> El contenido de esta web tiene carácter exclusivamente informativo y divulgativo. No constituye asesoramiento financiero, fiscal ni recomendación explícita de inversión.
            </span>
          </p>
        </div>

        <!-- ENLACES LEGALES (CON LAS RUTAS REALES DE TU PROYECTO) -->
        <div class="flex items-center gap-4 font-medium text-slate-400 flex-wrap justify-center md:justify-end">
          <a href="/blog" class="hover:text-amber-400 transition-colors">Blog</a>
          <a href="/aviso-legal" class="hover:text-amber-400 transition-colors">Aviso Legal</a>
          <a href="/privacidad" class="hover:text-amber-400 transition-colors">Política de Privacidad</a>
          <a href="/cookies" class="hover:text-amber-400 transition-colors">Política de Cookies</a>
          <a href="/politica-editorial" class="hover:text-amber-400 transition-colors">Política Editorial</a>
        </div>

      </div>
    </footer>

  </body>
</html>
