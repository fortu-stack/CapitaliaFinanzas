---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Capitalia Finanzas | Análisis Económico e Inversión Independiente", 
  description = "Análisis económico riguroso, fiscalidad, pensiones y herramientas financieras independientes." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Carga de Tailwind via CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#fffbe1',
                500: '#f59e0b',
                600: '#d97706',
                900: '#78350f',
              }
            }
          }
        }
      }
    </script>

    <style is:global>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: #ffffff;
        color: #0f172a;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body class="bg-white text-slate-900 antialiased min-h-screen flex flex-col selection:bg-amber-500 selection:text-white">
    
    <!-- HEADER / NAVEGACIÓN -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-2xl">📈</span>
          <span class="font-black text-xl tracking-tight text-slate-900 group-hover:text-amber-600 transition-colors">
            CAPITALIA<span class="text-amber-600">.</span>
          </span>
        </a>

        <nav class="flex items-center gap-6 text-sm font-semibold text-slate-700">
          <a href="/" class="hover:text-amber-600 transition-colors">Inicio</a>
          <a href="/blog" class="hover:text-amber-600 transition-colors">Artículos</a>
          <a href="/#herramientas" class="hover:text-amber-600 transition-colors">Herramientas</a>
        </nav>
      </div>
    </header>

    <!-- CONTENIDO PRINCIPAL DE LA PÁGINA -->
    <div class="flex-1">
      <slot />
    </div>

    <!-- FOOTER EN AZUL MARINO OSCURO -->
    <footer class="bg-blue-950 text-slate-300 border-t border-blue-900 py-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-2">
          <span class="text-xl">📈</span>
          <span class="font-bold text-white tracking-tight">CAPITALIA FINANZAS</span>
        </div>
        <p class="text-xs text-slate-400 text-center md:text-left">
          © {new Date().getFullYear()} Capitalia Finanzas. Análisis independiente. No constituye asesoramiento financiero.
        </p>
        <div class="flex gap-4 text-xs font-medium">
          <a href="/blog" class="hover:text-amber-400">Blog</a>
          <a href="#" class="hover:text-amber-400">Aviso Legal</a>
        </div>
      </div>
    </footer>

  </body>
</html>
